# ==========================================
# SafeTrip Backend Environment Configuration
# ==========================================

# Database
DB_URL=jdbc:mysql://localhost:3306/safe_trip?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Security (Generate a secure 256-bit secret key)
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_hex
JWT_EXPIRATION_MS=86400000

# Google Maps Platform (Places API, Geocoding API)
# Get your API key from Google Cloud Console: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAI API Key (Optional for AI Travel Assistant)
GROQ_API_KEY=your_actual_groq_api_key

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
